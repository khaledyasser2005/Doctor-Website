rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'abdomohamed20052024@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPatientAccount(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'authProvider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'authProvider', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.fullName is string
        && data.fullName.size() >= 1
        && data.fullName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.authProvider is string
        && data.authProvider == 'google'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPatientAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(userId)
        && isValidPatientAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().authProvider == existing().authProvider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'updatedAt']))
        );

      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
